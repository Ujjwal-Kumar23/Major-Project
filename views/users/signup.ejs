<% layout("/layouts/boilerplate") %>

<style>
  .animation1 {
    max-width: 1200px; /* 🔥 width control */
    margin: 50px auto; /* 🔥 center me laata hai */
    padding: 25px;
    border-radius: 15px;
  }
</style>

<div class="row mt-5 animation1">
  <h1 class="col-5 offset-3">SignUp on Wonderlust</h1>
  <div class="col-6 offset-3">
    <form action="/signup" method="POST" class="needs-validation" novalidate>
      <div class="mb-3">
        <label class="username">Username</label>
        <input
          name="username"
          id="username"
          type="text"
          class="form-control"
          required
        />
        <div class="valid-feedback">Looks good!😊</div>
      </div>
      <div class="mb-3">
        <label class="email">Email</label>
        <input
          name="email"
          id="email"
          type="email"
          class="form-control"
          required
        />
      </div>
      <div class="mb-3">
        <label class="password">Password</label>
        <input
          name="password"
          id="password"
          type="password"
          class="form-control"
          required
        />
      </div>
      <button class="btn btn-success">SignUp</button>
    </form>
  </div>
</div>
