<div class="row mt-5">
  
  <div class="col-6 offset-3 animation1">
    
    <h1 class="text-center mb-4">Login</h1>

    <form action="/login" method="POST" class="needs-validation" novalidate>
      
      <div class="mb-3">
        <label class="username">Username</label>
        <input
          name="username"
          id="username"
          type="text"
          class="form-control"
          required
        />
      </div>

      <div class="mb-3">
        <label class="password">Password</label>
        <input
          name="password"
          id="password"
          type="password"
          class="form-control"
          required
        />
      </div>

      <button class="btn btn-success w-100">Login</button>
    
    </form>

  </div>
</div>